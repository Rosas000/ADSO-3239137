# Plantilla de variables de entorno de Event Furniture.
#
# Preparación única, desde la carpeta plan-mejoramiento:
#   cp infra/.env.example infra/.env
#
# El archivo .env real nunca se versiona (RNF05).

# Aplicación
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=UTC

# Clave de Laravel. Puede quedar vacía: el entrypoint del contenedor api
# la genera en el arranque si no encuentra valor.
# Para fijar una clave estable entre recreaciones del contenedor, generarla con
#   php artisan key:generate --show
# y pegarla aquí. Los tokens de Sanctum no dependen de esta clave.
APP_KEY=

# Puertos expuestos en el equipo anfitrión
API_PORT=8000
APP_PORT=8081
PAGE_PORT=8080

# Puerto de la base de datos solo si se descomenta el bloque ports de db
# en docker-compose.yml. Por defecto la base de datos no se expone.
# DB_PORT=5433

# Credenciales de PostgreSQL
DB_DATABASE=event_furniture
DB_USERNAME=event_furniture
DB_PASSWORD=cambiar_esta_clave

# URL de la API que consume el frontend en el navegador.
# Es localhost porque la petición sale del navegador, no del contenedor.
VITE_API_URL=http://localhost:8000/api/v1
